{% extends 'base.html.twig' %}

{% block body %}
    <h1>Добавить домик</h1>
    <form method="POST" action="{{ path('create_house') }}">
        <label>Название:</label><br>
        <input type="text" name="name" required><br><br>

        <label>Количество спальных мест:</label><br>
        <input type="text" name="beds" required><br><br>

        <label>Количество ванных комнат:</label><br>
        <input type="text" name="bathrooms" required><br><br>

        <label>Цена:</label><br>
        <input type="text" name="price" required><br><br>

        <label>Количество свободных домиков:</label><br>
        <input type="text" name="available" required><br><br>

        <label>Удобства:</label><br>
        <textarea name="facilities" rows="4" cols="50" required></textarea><br><br>

        <input type="submit" value="Добавить">
        <a href="{{ path('home') }}"><button>Отмена</button></a>
    </form>
{% endblock %}

{% block style %}
    div {
        margin-bottom: 15px;
    }
    input[type="text"] {
        background-color: #f9f9f9ff;
        border-color: #dededeff;
        border-radius: 6px;
        padding: 4px;
    }
    input[type="submit"] {
        font-family: Verdana, sans-serif;
        padding: 8px;
        border: none;
        border-radius: 5px;
        transition-duration: 0.4s;
    }
    input[type="submit"]:hover {
        background-color: #cfd0cfff;
    }
    textarea {
        font-family: Verdana, sans-serif;
        background-color: #f9f9f9ff;
        border-color: #dededeff;
        border-radius: 6px;
        padding: 4px;
    }
{% endblock %}

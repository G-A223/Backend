{% extends 'base.html.twig' %}

{% block body %}
    {% for message in app.flashes('Success') %}
        <div>✅ {{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('Fail') %}
        <div>❌ {{ message }}</div>
    {% endfor %}

    <h1>Все доступные домики:</h1>
    {% if houses is empty %}
        <p>Нет доступных домиков</p>
    {% else %}
        <table>
            <tbody>
                {% for house in houses %}
                <!--Здесь проверяем, что количество домиков данного типа ненулевое и доступно для бронирования-->
                {% if house[6] != "0" %}
                    <tr>
                        {% for elem in house %}
                            <td>{{ elem }}</td>
                        {% endfor %}
                    </tr>
                {% endif %}
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
    <br><br>

    <h1>Существующие заявки:</h1>
    {% if reservations is empty %}
        <p>Пока заявок нет</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <td>ID заказа</td>
                    <td>ID домика</td>
                    <td>Номер телефона</td>
                    <td>Комментарий</td>
                    <td>Изменить заявку</td>
                </tr>
            </thead>
            <tbody>
                {% for reserv in reservations %}
                    <tr>
                        {% for elem in reserv %}
                            <td>{{ elem }}</td>
                        {% endfor %}

                        <td style="text-align: center; vertical-align: middle;">
                            <a href="{{ path('edit', {id: reserv[0]}) }}">
                                <button>Редактировать</button>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
    <br><br>

    <h1>Создать заявку:</h1>
    <form method="POST" action="{{ path('reserve') }}">
        <label>Номер телефона:</label><br>
        <input type="text" name="phone_number" required><br><br>

        <label>Id домика:</label><br>
        <input type="text" name="id" required><br><br>

        <label>Комментарий:</label><br>
        <textarea name="comment" rows="4" cols="50" required></textarea><br><br>

        <input type="submit" value="Забронировать">
    </form>
{% endblock %}

{% block style %}
    table {
        border-radius: 10px;
        border-spacing: 0;
        overflow: hidden;
    }
    table, th, td {
        border: 1px solid grey;
    }
    th, td {
        padding: 12px;
        text-align: left;
    }
    input[type="text"] {
        background-color: #f9f9f9ff;
        border-color: #dededeff;
        border-radius: 6px;
        padding: 4px;
    }
    input[type="submit"] {
        font-family: Verdana, sans-serif;
        padding: 8px;
        border: none;
        border-radius: 5px;
        transition-duration: 0.4s;
    }
    input[type="submit"]:hover {
        background-color: #cfd0cfff;
    }
    textarea {
        font-family: Verdana, sans-serif;
        background-color: #f9f9f9ff;
        border-color: #dededeff;
        border-radius: 6px;
        padding: 4px;
    }
{% endblock %}

